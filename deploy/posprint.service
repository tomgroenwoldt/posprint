[Unit]
Description=posprint - HTTP service for a USB ESC/POS receipt printer
Documentation=file:///opt/posprint/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=posprint
Group=lp
WorkingDirectory=/opt/posprint
EnvironmentFile=/etc/posprint.env
ExecStart=/opt/posprint/venv/bin/python -m posprint
Restart=on-failure
RestartSec=5s

# Hardening.
#
# Deliberately NOT set: PrivateDevices=yes. It replaces /dev with a minimal
# tmpfs containing only the standard pseudo-devices, which hides /dev/usb/lp0
# and breaks the entire point of this service. Same reason DevicePolicy is left
# at the default: locking it down needs the usblp cgroup device class named
# correctly and fails closed in confusing ways if it isn't.
#
# The Protect*/Private* directives below need a private mount namespace, which
# an unprivileged LXC cannot create (start fails with 226/NAMESPACE). install.sh
# detects that and drops in deploy/posprint-container.conf to disable just those
# lines. This file stays fully hardened for bare metal, VMs and privileged
# containers.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
