[Unit]
Description=posprint camera relay - one feed in, many viewers out
Documentation=file:///opt/posprint-relay/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=posprintrelay
Group=posprintrelay
WorkingDirectory=/opt/posprint-relay
EnvironmentFile=/etc/posprintweb-relay.env
ExecStart=/opt/posprint-relay/venv/bin/python -m posprintweb.relay
Restart=on-failure
RestartSec=5s

# No StateDirectory: the relay holds one frame in memory and writes nothing.
# Losing everything it knows on a restart costs a reconnect.

# Hardening.
#
# Tighter than the container's unit in two ways, both because this runs on a
# rented machine and does strictly less:
#
#   - No ffmpeg, so none of the @resources exception the main unit needs for
#     libnuma's set_mempolicy call. @resources stays denied outright.
#   - ProtectSystem=strict with no state directory means the whole filesystem
#     is read-only to it.
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
PrivateUsers=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
